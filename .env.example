# PostgreSQL Configuration
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your_secure_password_here

# N8N Basic Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=your_email@example.com
N8N_BASIC_AUTH_PASSWORD=your_secure_password_here

# N8N Domain Configuration
N8N_HOST=your-domain.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-domain.com/

# N8N Security (GENERATE NEW VALUES FOR PRODUCTION!)
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here
N8N_JWT_AUTH_HEADER=n8n-api-key
N8N_JWT_AUTH_HEADER_VALUE=your_jwt_secret_key_here

# Additional Security
N8N_SECURE_COOKIE=true
N8N_LOG_LEVEL=info
N8N_METRICS=true

# Optional: Email Configuration
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.gmail.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=your_email@gmail.com
# N8N_SMTP_PASS=your_app_password
# N8N_SMTP_SECURE=true

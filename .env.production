# PostgreSQL Configuration
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8nDB@2026!SecurePassword

# N8N Basic Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin@seu-dominio.com
N8N_BASIC_AUTH_PASSWORD=n8nAdmin@2026!SecureAccess

# N8N Domain Configuration
WEBHOOK_URL=https://seu-dominio.com/
N8N_HOST=seu-dominio.com
N8N_PROTOCOL=https

# N8N Security
N8N_SECURE_COOKIE=true
N8N_LOG_LEVEL=info
N8N_METRICS=true

# N8N Additional Security (Required for Production)
N8N_ENCRYPTION_KEY=n8nSecureKey2026Production32Chars
N8N_JWT_AUTH_HEADER=n8n-api-key
N8N_JWT_AUTH_HEADER_VALUE=n8nJWTSecret2026SecureTokenHere
